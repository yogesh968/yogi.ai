# ===== REQUIRED =====
# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Supabase -> Connect -> "Session pooler" (port 5432). Percent-encode special chars in the password.
# postgresql://postgres.<project-ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# ===== ABOUT YOU =====
OWNER_NAME=Yogesh
CALLER_LANGUAGES=English, Hindi, Hinglish
TIMEZONE=Asia/Kolkata

# ===== MODELS (verified Oct 2026) =====
LIVE_MODEL=gemini-3.8-live
POSTCALL_MODEL=gemini-3.8-flash

# ===== AUDIO (substring match; run `python -m app.devices` to list) =====
CALLER_INPUT_DEVICE=CABLE Output
AI_OUTPUT_DEVICE=Hi-Fi Cable Input
# Test mode: blank = Windows default mic / speakers
TEST_INPUT_DEVICE=
TEST_OUTPUT_DEVICE=
AUDIO_HOSTAPI=Windows WASAPI
CHUNK_MS=20
SILENCE_RMS_THRESHOLD=350

# ===== DEFAULTS (editable later in dashboard Settings) =====
DEFAULT_VOICE=Puck
DEFAULT_RECORDING_ENABLED=true
DEFAULT_SILENCE_TIMEOUT_S=45

# ===== SERVER (loopback only) =====
HOST=127.0.0.1
PORT=8765
