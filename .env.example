# ======================================================================
#  Copy to .env (laptop) and/or .env.server (cloud). Never commit these.
# ======================================================================

# ----- REQUIRED -----
# Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Supabase -> Connect -> "Session pooler" (port 5432). Percent-encode special characters in the password.
# postgresql://postgres.<project-ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# ----- ABOUT YOU -----
OWNER_NAME=Yogesh
# Your own mobile number (E.164). Calls forwarded from it are recognised.
OWNER_PHONE=+91
CALLER_LANGUAGES=English, Hindi, Hinglish
TIMEZONE=Asia/Kolkata

# ----- MODELS (verified Oct 2026) -----
LIVE_MODEL=gemini-3.8-live
POSTCALL_MODEL=gemini-3.8-flash

# ----- PHONE LINE: Vobiz (needed for real calls; leave blank for practice-only) -----
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
# The number you rented on Vobiz, E.164 (+91...)
VOBIZ_NUMBER=
# Random secret that becomes part of the webhook URLs. Generate:  python -c "import secrets;print(secrets.token_urlsafe(24))"
VOBIZ_WEBHOOK_SECRET=
MAX_CONCURRENT_CALLS=2

# ----- CLOUD DEPLOYMENT (.env.server only; leave blank on the laptop) -----
# e.g. https://yogi-assistant.duckdns.org
PUBLIC_BASE_URL=
# Dashboard login password (min 10 chars)
DASHBOARD_PASSWORD=
# Generate:  python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=

# ----- DEFAULTS (editable later in the dashboard) -----
DEFAULT_VOICE=Puck
DEFAULT_RECORDING_ENABLED=true
DEFAULT_SILENCE_TIMEOUT_S=45

# ----- TUNING (defaults are good) -----
VAD_START_SENSITIVITY=low
VAD_END_SENSITIVITY=high
VAD_SILENCE_MS=500
SILENCE_RMS_THRESHOLD=350

# ----- PRACTICE MODE on your laptop (blank = default mic/headphones) -----
TEST_INPUT_DEVICE=
TEST_OUTPUT_DEVICE=
AUDIO_HOSTAPI=Windows WASAPI
